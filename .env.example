# Copy to .env (git-ignored). PUBLIC_ values are bundled into the site — the anon key is meant to be public.
# Supabase → Project Settings → API
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...

# The /admin password is NOT stored here: a static site ships every env value to the browser,
# so it lives hashed inside Supabase instead. Set it with:  select set_admin_password('...');
# (full SQL at the top of src/lib/track.ts)
